<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TodoApp.ViewModels"
             x:Class="TodoApp.MainPage"
             Title="Mis Tareas">

    <ContentPage.BindingContext>
        <vm:TodoViewModel />
    </ContentPage.BindingContext>

    <Shell.TitleView>
        <Grid Padding="16,0">
            <Label Text="Mis Tareas" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="8">

        <!-- Lista -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="{Binding PendingCount, StringFormat='{0} pendientes'}"
                   TextColor="Gray"
                   FontSize="14"
                   Margin="0,0,0,6" />

            <Label Text="No tienes tareas todavía"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,40,0,0"
                   IsVisible="{Binding IsEmpty}" />
            <Label Text="Añade tu primera tarea abajo"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   IsVisible="{Binding IsEmpty}" />

            <CollectionView ItemsSource="{Binding Todos}"
                            IsVisible="{Binding HasTodos}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,4" Padding="10" HasShadow="True" CornerRadius="8" BorderColor="#E0E0E0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsCompleted}"
                                          IsCheckedChanged="OnItemToggled"
                                          VerticalOptions="Center"
                                          CommandParameter="{Binding .}" />
                                <!-- Textos -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           FontSize="16"
                                           FontAttributes="None">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="TextColor" Value="Gray" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="Gray" />
                                </VerticalStackLayout>
                                <!-- Delete -->
                                <Button Grid.Column="2"
                                        Text="🗑"
                                        BackgroundColor="Transparent"
                                        TextColor="DarkRed"
                                        WidthRequest="40"
                                        Clicked="OnDeleteClicked"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Formulario abajo -->
        <Border Grid.Row="1" Stroke="#E0E0E0" StrokeThickness="1" Background="White" Padding="12" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="8">
                <Entry Text="{Binding NewTitle}" Placeholder="Título de la tarea" />
                <Entry Text="{Binding NewDescription}" Placeholder="Descripción (opcional)" />
                <Button Text="+ Añadir Tarea" Command="{Binding AddCommand}" />
                <Button Text="Borrar completadas"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        IsVisible="{Binding HasTodos}"
                        Command="{Binding DeleteCompletedCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Convertidor simple vía trigger, en producción usar NullToBoolConverter -->
            <DataTemplate x:Key="DummyTemplate" />
        </ResourceDictionary>
    </ContentPage.Resources>
</ContentPage>
